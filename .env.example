# ==============================================================================
# CINIHUB - Environment Configuration Template
# ==============================================================================

# TMDB API Read Access Token (Recommended v4 Bearer Token)
# Obtain from: https://www.themoviedb.org/settings/api
VITE_TMDB_TOKEN=your_tmdb_read_access_token_here

# (Optional) TMDB API Key v3
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Obtain from Supabase Project Settings > API:
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

